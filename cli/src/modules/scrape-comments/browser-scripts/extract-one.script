const IGNORE_TEXTS = new Set(['Like', 'Reply', 'Log in', 'Sign up', 'Comment', 'Share', 'Save']);
const isProfileHref = (href) => {
  if (!href || !href.startsWith('/')) return false;
  if (href.startsWith('/p/') || href.startsWith('/reel/') || href.startsWith('/reels/')) return false;
  if (href.includes('/c/') || href.startsWith('/explore/') || href.startsWith('/accounts/')) return false;
  return /^\/[A-Za-z0-9._]+\/?($|\?)/.test(href);
};
const isValidUsername = (username) => /^[a-zA-Z0-9._]{2,30}$/.test(username || '');
const parseLikesInfo = (root, ownerUsername) => {
  const scopes = [];
  const add = (node) => { if (node && !scopes.includes(node)) scopes.push(node); };
  add(root);
  add(root?.parentElement);
  add(root?.previousElementSibling);
  add(root?.nextElementSibling);
  let current = root;
  for (let i = 0; i < 4 && current; i += 1) {
    add(current.parentElement);
    add(current.parentElement?.previousElementSibling);
    add(current.parentElement?.nextElementSibling);
    current = current.parentElement;
  }
  const raw = scopes.map((node) => (node?.innerText || '')).join(' ').replace(/\s+/g, ' ').trim();
  const m = raw.match(/(\d+[\d.,]*)\s*likes?/i)
    || raw.match(/(\d+[\d.,]*)\s*gefällt\s*mir(?:-angaben|\s*mal)?/i)
    || raw.match(/gefällt\s+(\d+[\d.,]*)\s*mal/i);
  const likesCount = m ? parseInt((m[1] || '').replace(/[.,]/g, ''), 10) || 0 : 0;
  const seen = new Set();
  const likers = [];
  const links = scopes.flatMap((node) => Array.from(node?.querySelectorAll?.('a[href]') || []));
  for (const a of links) {
    const href = a.getAttribute('href') || '';
    if (!isProfileHref(href)) continue;
    const uname = (a.textContent || '').trim().replace(/\s+/g, '').replace(/verified$/i, '');
    if (!uname || !/^[a-zA-Z0-9._]{2,30}$/.test(uname)) continue;
    if (ownerUsername && uname.toLowerCase() === ownerUsername.toLowerCase()) continue;
    const key = uname.toLowerCase();
    if (seen.has(key)) continue;
    seen.add(key);
    likers.push({ username: uname, profilePath: href });
    if (likers.length >= 10) break;
  }
  return { likesCount, likers };
};
const badText = (value, username, timeText, profileSlug) => {
  const text = (value || '').trim();
  if (!text) return true;
  const lower = text.toLowerCase();
  const owner = (username || '').trim().toLowerCase();
  const time = (timeText || '').trim().toLowerCase();
  if (text === username || lower === owner || lower === time) return true;
  if (IGNORE_TEXTS.has(text)) return true;
  if (['reply', 'replies', 'edited', 'bearbeitet', 'antworten', 'antwort', 'gefällt mir'].includes(lower)) return true;
  if (/^\d+\s*(h|d|w|m|s)$/i.test(text)) return true;
  if (/^\d+\s*(std\.|tag|tage|w|wo\.|min|sek)\s*$/i.test(text)) return true;
  if (/^\d+\s*likes?$/i.test(text)) return true;
  if (/^gefällt\s+\d+[\d.,]*\s*mal$/i.test(text)) return true;
  if (/^(?:\d+\s*(?:sek\.?|min\.?|std\.?|h|d|w|m|j|tag(?:e)?|wo\.?)\s*)?(?:·\s*)?(edited|bearbeitet)$/i.test(lower)) return true;
  if (/^.*·\s*(edited|bearbeitet)$/i.test(lower)) return true;
  if (/^[a-z0-9._]{2,30}(?:\s*verifiziert)?$/i.test(text)) {
    const normalized = lower.replace(/\s*verifiziert$/i, '');
    if (normalized === owner || normalized === profileSlug) return true;
  }
  return false;
};
const profileSlugFromHref = (href) => {
  const m = String(href || '').match(/^\/([^/?#]+)\/?$/);
  return (m?.[1] || '').trim().toLowerCase();
};
const normalizeTimeText = (value) => {
  const raw = (value || '').replace(/\s+/g, ' ').trim();
  if (!raw) return '';
  const rel = raw.match(/(\d+\s*(?:sek\.?|min\.?|std\.?|h|d|w|m|j|tag(?:e)?|wo\.?))/i);
  if (rel) return rel[1];
  const abs = raw.match(/(\d{1,2}\.\s*[\p{L}]+(?:\s*\d{4})?)/iu);
  if (abs) return abs[1];
  return raw;
};
const pickText = (node, username, timeText, profileSlug) => {
  const spans = Array.from(node.querySelectorAll('span'))
    .map((span) => span.textContent?.trim() || '')
    .filter((text) => text.length > 0 && !IGNORE_TEXTS.has(text));
  return spans
    .filter((item) => !badText(item, username, timeText, profileSlug))
    .sort((a, b) => b.length - a.length)
    .find((item) => item.length >= 2) || '';
};
const timeEl = el;
const timeText = normalizeTimeText(timeEl.textContent?.trim() ?? '');
let node = timeEl.parentElement;
for (let depth = 0; depth < 24 && node; depth += 1) {
  const userLink = Array.from(node.querySelectorAll('a[role="link"], a'))
    .find((link) => isProfileHref(link.getAttribute('href') || ''));
  if (!userLink) { node = node.parentElement; continue; }
  const username = (userLink.textContent || '').trim().replace(/\s+/g, '').replace(/verified$/i, '');
  if (!isValidUsername(username)) { node = node.parentElement; continue; }
  const profileSlug = profileSlugFromHref(userLink.getAttribute('href'));
  const text = pickText(node, username, timeText, profileSlug);
  if (!text) { node = node.parentElement; continue; }
  const likesInfo = parseLikesInfo(node, username);
  return {
    commentPermalink: node.querySelector('a[href*="/c/"]')?.getAttribute('href') ?? null,
    datetime: timeEl.getAttribute('datetime'),
    isGifOnly: false,
    commentLikers: likesInfo.likers,
    likesCount: likesInfo.likesCount,
    text,
    timeText,
    username,
    userProfilePath: userLink.getAttribute('href'),
  };
}
return null;
