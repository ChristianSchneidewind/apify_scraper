const LOAD_MORE_TEXTS = __LOAD_MORE_TEXTS__;

const expandReplyThreadsUi = (maxClicks) => {
  const attempts = globalThis.__instagramCliReplyAttempts
    || (globalThis.__instagramCliReplyAttempts = new Map());
  const nodes = Array.from(document.querySelectorAll('button, [role="button"], a, span[role="button"]'));
  let clicked = 0;
  for (const node of nodes) {
    if (clicked >= maxClicks) break;
    const text = (node.textContent || '').trim().toLowerCase();
    if (!text) continue;
    const looksLikeReplies =
      (text.includes('repl') || text.includes('antwort')) &&
      (text.includes('view') || text.includes('show') || text.includes('anzeigen') || text.includes('ansehen') || text.includes('more') || /\d/.test(text));
    if (!looksLikeReplies) continue;
    let current = node;
    let permalink = '';
    for (let depth = 0; depth < 16 && current; depth += 1) {
      permalink = current.querySelector?.('a[href*="/c/"]')?.getAttribute?.('href') || '';
      if (permalink) break;
      current = current.parentElement;
    }
    const key = permalink || `${text}|${(node.parentElement?.textContent || '').trim().slice(0, 160)}`;
    const previousAttempts = attempts.get(key) || 0;
    // React can ignore a click while a Reel row is being re-rendered. Retry a
    // persistent control, but cap attempts so one bad thread cannot hang setup.
    if (previousAttempts >= 3) continue;
    attempts.set(key, previousAttempts + 1);
    if (typeof node.click === 'function') node.click();
    else node.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true }));
    clicked += 1;
  }
  return clicked;
};

const expandCommentUi = (texts) => {
  const nodes = document.querySelectorAll('button, [role="button"], a, span[role="button"]');
  let count = 0;
  for (const el of nodes) {
    const text = (el.textContent || '').trim();
    if (!text) continue;
    const lower = text.toLowerCase();
    const isReplyOnly = lower === 'reply' || lower === 'antworten';
    const looksLikeReplies = (lower.includes('repl') || lower.includes('antwort')) && /\d/.test(text);
    const looksLikeView = lower.includes('view') || lower.includes('more') || lower.includes('anzeigen') || lower.includes('ansehen');
    const matchesExpand = texts.some((item) => text.includes(item)) || (looksLikeReplies && looksLikeView);
    if (isReplyOnly || !matchesExpand) continue;
    if (typeof el.click === 'function') el.click();
    else el.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true }));
    count += 1;
  }
  return count;
};

return {
  expandCommentUi,
  expandReplyThreadsUi,
  LOAD_MORE_TEXTS,
};
