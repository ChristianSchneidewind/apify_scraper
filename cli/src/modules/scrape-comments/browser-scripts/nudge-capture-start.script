(node = null) => {
  const score = (el) => el.scrollHeight - el.clientHeight;
  const visible = (el) => el.querySelectorAll('time').length > 0;
  const pick = (nodes) => nodes
    .filter(visible)
    .filter((el) => score(el) > 40)
    .sort((a, b) => score(b) - score(a))[0];
  const descendents = node
    ? Array.from(node.querySelectorAll('div, ul, section, article'))
    : [];
  const globalNodes = Array.from(document.querySelectorAll('div, ul, section, article'));
  const candidates = [pick(descendents), pick(globalNodes), node]
    .filter(Boolean);
  const target = candidates[0] || document.scrollingElement || document.documentElement || document.body;
  if (!target) return false;
  const before = target.scrollTop || 0;
  const step = Math.max(120, Math.floor((target.clientHeight || 0) * 0.18));
  const next = Math.min(before + step, Math.max(0, (target.scrollHeight || 0) - (target.clientHeight || 0)));
  target.scrollTop = next;
  return Math.abs(target.scrollTop - before) > 0;
}
