(container = null) => {
  const isReel = /\/reels?\//.test(location.pathname);

  const isScrollable = (node) => !!node && node.scrollHeight - node.clientHeight > 40;

  const findScrollableAncestor = (node) => {
    let current = node;
    for (let i = 0; i < 8 && current; i += 1) {
      if (isScrollable(current)) return current;
      current = current.parentElement;
    }
    return null;
  };

  const findTarget = (node, boundary = null) => {
    let current = node;
    for (let i = 0; i < 8 && current; i += 1) {
      if (isScrollable(current)) return current;
      if (boundary && current === boundary) break;
      current = current.parentElement;
    }
    return null;
  };

  const findCandidate = () => {
    if (container) return findTarget(container) || container;
    const dialogCandidates = Array.from(document.querySelectorAll('div[role="dialog"] div, div[role="dialog"] ul, div[role="dialog"] section'))
      .filter((el) => el.querySelectorAll('time').length > 0)
      .filter((el) => el.scrollHeight - el.clientHeight > 40);

    const genericCandidates = Array.from(document.querySelectorAll('div, ul, section'))
      .filter((el) => el.querySelectorAll('time').length > 1)
      .filter((el) => el.scrollHeight - el.clientHeight > 80);

    // In the Reel viewer the page itself contains another large scrollable
    // area (the caption/video column). Never use that as a fallback: scrolling
    // it makes the description move instead of the comments.
    if (isReel && !dialogCandidates.length) return null;
    const candidates = dialogCandidates.length ? dialogCandidates : genericCandidates;
    if (!candidates.length) return null;
    candidates.sort((a, b) => (b.scrollHeight - b.clientHeight) - (a.scrollHeight - a.clientHeight));
    const boundary = isReel ? document.querySelector('[role="dialog"]') : null;
    return findTarget(candidates[0], boundary) || candidates[0];
  };

  const target = findCandidate();
  if (!target) {
    if (isReel) return false;
    const before = window.scrollY;
    window.scrollBy(0, window.innerHeight * 0.8);
    return Math.abs(window.scrollY - before) > 10;
  }

  const before = target.scrollTop;
  const next = Math.min(target.scrollTop + Math.max(160, target.clientHeight * 0.95), target.scrollHeight);
  target.scrollTop = next;
  const moved = Math.abs(target.scrollTop - before);
  if (!moved && isReel) return false;
  return moved > 0;
}
