__HELPERS__
return (payload) => {
  const { el, commentPermalink } = payload;
  const row = el?.closest?.('li, [role="listitem"], article, div') || el;
  if (!row) return { ok: false, reason: 'row_missing' };

  const permalinkAnchor = commentPermalink
    ? row.querySelector(`a[href="${commentPermalink}"]`)
      || (row.contains?.(document.querySelector(`a[href="${commentPermalink}"]`))
        ? document.querySelector(`a[href="${commentPermalink}"]`)
        : null)
    : null;
  const rowFromPermalink = permalinkAnchor?.closest?.('li, [role="listitem"], article, div')
    || (permalinkAnchor && row.contains(permalinkAnchor) ? row : null);

  // Ascend only while the scope still contains this one permalink. This
  // reaches the comment's likes control without leaking into reply threads or
  // the complete Reel comments dialog.
  const scopes = [];
  let scope = row;
  for (let depth = 0; depth < 10 && scope; depth += 1) {
    if (scope.querySelectorAll?.('a[href*="/c/"]').length > 1) break;
    scopes.push(scope);
    scope = scope.parentElement;
  }

  const txt = scopes.map((s) => (s?.innerText || '')).join(' ').replace(/\s+/g, ' ');
  const m = txt.match(/(\d+[\d.,]*)\s*likes?/i)
    || txt.match(/(\d+[\d.,]*)\s*gefällt\s*mir(?:-angaben|\s*mal)?/i);
  const likesCount = m ? parseInt((m[1] || '').replace(/[.,]/g, ''), 10) || 0 : 0;

  const controls = scopes.flatMap((s) => Array.from(
    s?.querySelectorAll?.('button, a, [role="button"], [tabindex="0"]') || [],
  ));
  let likesBtn = null;
  for (const c of controls) {
    if (!isSaneClickTarget(c)) continue;
    const t = (c.textContent || c.innerText || '').replace(/\s+/g, ' ').trim();
    const aria = (c.getAttribute('aria-label') || '').replace(/\s+/g, ' ').trim();
    const title = (c.getAttribute('title') || '').replace(/\s+/g, ' ').trim();
    if (isLikeText(t) || isLikeText(title) || isLikeText(aria)) {
      likesBtn = c;
      break;
    }
  }

  if (!likesBtn) {
    const textNodes = scopes.flatMap((s) => Array.from(
      s?.querySelectorAll?.('span, div, a, button') || [],
    ));
    const hit = textNodes.find((n) => isLikeText(
      (n.textContent || n.innerText || '').replace(/\s+/g, ' ').trim(),
    ));
    if (hit) {
      let p = hit;
      for (let i = 0; i < 8 && p; i += 1) {
        const role = (p.getAttribute?.('role') || '').toLowerCase();
        const tab = p.getAttribute?.('tabindex');
        if (isSaneClickTarget(p) && (
          p.tagName === 'BUTTON' || p.tagName === 'A' || role === 'button' || tab === '0'
        )) {
          likesBtn = p;
          break;
        }
        p = p.parentElement;
      }
    }
  }

  if (!likesBtn) {
    const nearPermalink = scopes.flatMap((s) => Array.from(
      s?.querySelectorAll?.('[aria-label], [title]') || [],
    ));
    likesBtn = nearPermalink.find((n) => {
      if (!isSaneClickTarget(n)) return false;
      const aria = (n.getAttribute('aria-label') || '').replace(/\s+/g, ' ').trim();
      const title = (n.getAttribute('title') || '').replace(/\s+/g, ' ').trim();
      return isLikeText(aria) || isLikeText(title);
    }) || null;
  }

  if (!likesBtn) return { ok: true, likesCount, clicked: false, reason: 'likes_button_not_found' };
  const clickEl = likesBtn.closest('button, [role="button"], a, [tabindex="0"]') || likesBtn;
  if (!isSaneClickTarget(clickEl)) {
    return { ok: true, likesCount, clicked: false, reason: 'likes_target_failed_sanity_check' };
  }
  document.querySelectorAll('[data-instagram-cli-likes-target="1"]')
    .forEach((node) => node.removeAttribute('data-instagram-cli-likes-target'));
  clickEl.setAttribute('data-instagram-cli-likes-target', '1');
  return { ok: true, likesCount, clicked: true };
};
