const scopes = [];
const add = (node) => { if (node && !scopes.includes(node)) scopes.push(node); };
const scope = el?.closest?.('li, [role="listitem"], article, div') || el;
add(el);
add(scope);
add(scope?.parentElement);
add(scope?.previousElementSibling);
add(scope?.nextElementSibling);
let current = scope;
for (let i = 0; i < 5 && current; i += 1) {
  add(current.parentElement);
  add(current.parentElement?.previousElementSibling);
  add(current.parentElement?.nextElementSibling);
  current = current.parentElement;
}
const txt = scopes.map((node) => (node?.textContent || '')).join(' ').replace(/\s+/g, ' ');
const m = txt.match(/(\d+[\d.,]*)\s*likes?/i)
  || txt.match(/(\d+[\d.,]*)\s*gefällt\s*mir(?:-angaben|\s*mal)?/i)
  || txt.match(/gefällt\s+(\d+[\d.,]*)\s*mal/i);
return m ? parseInt((m[1] || '').replace(/[.,]/g, ''), 10) || 0 : 0;
