document.querySelectorAll('[data-apify-highlight-overlay="1"]').forEach((prev) => prev.remove());
const banner = document.getElementById('apify-screenshot-banner');
const bannerH = banner ? banner.getBoundingClientRect().height : 0;
const maxBottom = window.innerHeight - bannerH - 20;
const nodes = Array.from(document.querySelectorAll('[data-apify-highlight="1"]'));
for (const node of nodes) {
  if (!(node instanceof HTMLElement)) continue;
  node.style.outline = '4px solid red';
  node.style.outlineOffset = '2px';
  node.style.boxShadow = '0 0 0 4px red inset, 0 0 0 2px rgba(255,0,0,0.35)';
  node.style.backgroundColor = 'rgba(255, 0, 0, 0.04)';
  node.style.backgroundClip = 'padding-box';
  const r = node.getBoundingClientRect();
  const top = Math.max(20, r.top);
  const bottom = Math.min(maxBottom, r.bottom);
  if (bottom <= top) continue;
  const overlay = document.createElement('div');
  overlay.setAttribute('data-apify-highlight-overlay', '1');
  overlay.style.position = 'fixed';
  overlay.style.pointerEvents = 'none';
  overlay.style.zIndex = '2147483646';
  overlay.style.left = `${Math.max(0, r.left - 4)}px`;
  overlay.style.top = `${top}px`;
  overlay.style.width = `${Math.max(1, r.width + 8)}px`;
  overlay.style.height = `${Math.max(1, bottom - top)}px`;
  overlay.style.borderLeft = '4px solid red';
  overlay.style.borderRight = '4px solid red';
  overlay.style.borderTop = r.top >= 18 ? '4px solid red' : '0';
  overlay.style.borderBottom = r.bottom <= maxBottom + 2 ? '4px solid red' : '0';
  overlay.style.boxSizing = 'border-box';
  document.body.appendChild(overlay);
}
return !!el;
