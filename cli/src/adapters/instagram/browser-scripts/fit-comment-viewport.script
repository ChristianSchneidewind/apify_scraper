return (payload) => {
  const { el } = payload;
  const isReel = /\/reels?\//.test(location.pathname);
  const dialog = isReel ? el?.closest?.('[role="dialog"]') : null;
  const target = el?.closest?.('li, [role="listitem"], article, div') || el;
  if (!target) return false;

  try {
    const scrollParent = (() => {
      let current = target.parentElement;
      while (current) {
        if (current.scrollHeight - current.clientHeight > 20
            && (!dialog || dialog.contains(current))) return current;
        current = current.parentElement;
      }
      return null;
    })();

    if (scrollParent) {
      const rect = target.getBoundingClientRect();
      const parentRect = scrollParent.getBoundingClientRect();
      const offset = rect.top - parentRect.top;
      scrollParent.scrollTop += offset - (scrollParent.clientHeight / 2);
    }

    if (!isReel) {
      target.scrollIntoView({ block: 'center', inline: 'nearest' });
      window.scrollBy(0, -120);
    }
  } catch (error) {}
  return true;
};
