{
  "title": "Instagram Comment Scraper Dataset",
  "description": "Output items produced per captured comment or profile screenshot.",
  "schemaVersion": 1,
  "type": "object",
  "properties": {
    "id": { "type": ["string", "null"] },
    "itemType": { "type": "string", "enum": ["comment", "profile"] },
    "username": { "type": "string" },
    "text": { "type": "string" },
    "isGifOnly": { "type": "boolean" },
    "datetime": { "type": ["string", "null"] },
    "timeText": { "type": ["string", "null"] },
    "commentPermalink": { "type": ["string", "null"] },
    "commentUrl": { "type": ["string", "null"] },
    "commentDeepLink": { "type": ["string", "null"] },
    "likesCount": { "type": "integer" },
    "commentLikers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "username": { "type": "string" },
          "profileUrl": { "type": "string" }
        },
        "required": ["username", "profileUrl"]
      }
    },
    "index": { "type": "integer" },
    "sourceUrl": { "type": "string" },
    "profileUrl": { "type": ["string", "null"] },
    "profileUsername": { "type": ["string", "null"] },
    "profileFullName": { "type": ["string", "null"] },
    "profileBiography": { "type": ["string", "null"] },
    "profileStats": { "type": "array", "items": { "type": "string" } },
    "profileAvatarUrl": { "type": ["string", "null"] },
    "screenshotKey": { "type": ["string", "null"] },
    "screenshotPath": { "type": ["string", "null"] },
    "screenshotKeys": { "type": "array", "items": { "type": "string" } },
    "screenshotPaths": { "type": "array", "items": { "type": "string" } },
    "partsTotal": { "type": "integer" },
    "multipartNeedsReview": { "type": "boolean" },
    "multipartFlagReason": { "type": ["string", "null"] },
    "metadataPath": { "type": ["string", "null"] }
  },
  "required": [
    "itemType",
    "username",
    "text",
    "isGifOnly",
    "likesCount",
    "commentLikers",
    "index",
    "sourceUrl",
    "profileStats",
    "screenshotKeys",
    "screenshotPaths",
    "partsTotal",
    "multipartNeedsReview"
  ]
}
